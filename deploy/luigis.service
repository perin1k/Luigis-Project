# Review template only. Do not install/enable without separate host authorization.
[Unit]
Description=Luigi's Pizza demonstration application
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/luigis-data
AssertPathIsMountPoint=/var/lib/luigis-data
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=luigis
Group=luigis
WorkingDirectory=/opt/luigis/current
EnvironmentFile=/etc/luigis/runtime.env
ExecStartPre=/usr/bin/test -f /var/lib/luigis-data/luigis-demo.sqlite
ExecStart=/usr/bin/node /opt/luigis/current/src/server.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths=/var/lib/luigis-data
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
