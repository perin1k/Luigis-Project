# Review template; copy only after authorized private host setup.
# Contains no keys, passwords or real customer data. Node does not load this file;
# the reviewed systemd EnvironmentFile supplies its settings.
NODE_ENV=production
HOST=0.0.0.0
PORT=443
AUTH_ORIGIN=https://luigispizzeria.duckdns.org
DATABASE_PATH=/var/lib/luigis-data/luigis-demo.sqlite
TLS_KEY_PATH=/etc/luigis/tls/privkey.pem
TLS_CERT_PATH=/etc/luigis/tls/fullchain.pem
DEMO_PAYMENT_KEYS_PATH=/etc/luigis/payment-keys.json
# REQUIRED: operator separately supplies MFA_ENCRYPTION_KEY_HEX through private
# configuration. There is deliberately no valid/default secret in this template.
# Missing MFA configuration must fail startup rather than create a fallback.
