# Non-secret template only; copy privately and supply the missing MFA key.
# Node is pinned to 24.14.1 / npm 11.11.0 for the reviewed Ubuntu release.
NODE_ENV=production
HOST=0.0.0.0
PORT=443
AUTH_ORIGIN=https://luigispizzeria.duckdns.org
DATABASE_PATH=/var/lib/luigis-data/luigis-demo.sqlite
TLS_KEY_PATH=/etc/luigis/tls/privkey.pem
TLS_CERT_PATH=/etc/luigis/tls/fullchain.pem
DEMO_PAYMENT_KEYS_PATH=/etc/luigis/payment-keys.json
# MFA_ENCRYPTION_KEY_HEX is deliberately absent: provision privately under OPS-03.
