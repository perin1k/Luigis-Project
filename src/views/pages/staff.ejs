<%# Staff sign-in, enrollment, MFA, recovery and account administration views. Available controls reflect server state; permissions are still enforced per action. %><!doctype html>
<html lang="en">
<head>
  <%- include('../partials/head', { bStaffPage: true }) %>
  <meta name="robots" content="noindex, nofollow">
  <script type="module" src="<%= strScriptBase %>/js/staff.js"></script>
</head>
<body>
  <%- include('../partials/header') %>
  <main id="main-content" class="container staff-page" tabindex="-1" data-staff-mode="<%= strMode %>" data-staff-owner="<%= bOwner %>" data-staff-lists="<%= JSON.stringify(objInitialLists) %>">
    <% if (bOrderQueue && strMode === 'account') { %>
    <nav class="d-flex flex-wrap gap-3" aria-label="Staff navigation">
      <a class="btn btn-primary" href="/staff/orders">Order queue</a>
      <% if (bOwner) { %><a class="btn btn-outline-primary" href="/staff/menu">Menu management</a><% } %>
      <% if (bAdmin) { %><a class="btn btn-outline-primary" href="/staff/analytics">Sales &amp; analytics</a><% } %>
    </nav>
    <% } %>
    <div class="staff-intro"><p class="eyebrow">Behind the counter</p><h1><%= ({'sign-in': 'Welcome back.', enroll: 'Join the team.', recovery: 'Recover your access.', account: 'Your staff account.'})[strMode] %></h1>
    <p>Good service starts with a team you can trust.</p></div>
    <noscript><p class="staff-notice">Enable JavaScript to use secure staff forms. Your password and authentication codes are never saved in browser storage.</p></noscript>
    <p id="staff-status" class="staff-notice" role="status" tabindex="-1" hidden></p>
    <div class="staff-grid">
    <% if (strMode === 'sign-in') { %>
      <section class="staff-card" aria-labelledby="sign-in-heading">
        <h2 id="sign-in-heading">Staff sign-in</h2><p>Use your individual account.</p>
        <form method="post" action="/auth/unavailable" data-endpoint="/login" data-result="login">
          <%- include('../partials/staff/field', {strId:'strUsername',strLabel:'Username',strType:'text',strAutocomplete:'username',intMax:64,strHint:null}) %>
          <%- include('../partials/staff/field', {strId:'strPassword',strLabel:'Password',strType:'password',strAutocomplete:'current-password',intMax:1024,strHint:null}) %>
          <button class="btn btn-primary" type="submit" disabled>Sign in</button>
        </form>
        <form method="post" action="/auth/unavailable" data-endpoint="/mfa" data-result="session" id="mfa-form" hidden>
          <%- include('../partials/staff/field', {strId:'strCode',strLabel:'Authenticator code',strType:'text',strAutocomplete:'one-time-code',intMax:6,strHint:'Enter the current six-digit code from your authenticator app.'}) %>
          <button class="btn btn-primary" type="submit" disabled>Verify and sign in</button>
          <a class="staff-secondary" href="/staff/sign-in">Start again</a>
        </form>
      </section>
      <aside class="staff-card staff-aside"><h2>A little help?</h2><p>New team members need a private invitation from an administrator.</p><a href="/staff/enroll">Accept an invitation</a><hr><p>Lost access to your authenticator?</p><a href="/staff/recovery">Recover admin access</a><p class="small mt-3">For other access problems, ask Brody to arrange identity verification and local recovery.</p></aside>
    <% } else if (strMode === 'enroll') { %>
      <section class="staff-card"><h2>Accept your invitation</h2><p>Your invitation expires after 24 hours and can be used once. New administrators must then complete first authenticator setup at the recovery page before signing in.</p>
        <form method="post" action="/auth/unavailable" data-endpoint="/employees/enroll" data-result="enrolled">
          <%- include('../partials/staff/field', {strId:'strInvitationToken',strLabel:'Invitation token',strType:'password',strAutocomplete:'off',intMax:64,strHint:'Paste the token your administrator shared privately.'}) %>
          <%- include('../partials/staff/field', {strId:'strPassword',strLabel:'Choose a password',strType:'password',strAutocomplete:'new-password',intMax:1024,strHint:'Use at least 15 characters. Choose a unique passphrase; common or username-based passwords are rejected.'}) %>
          <button class="btn btn-primary" type="submit" disabled>Create my staff account</button>
        </form><a class="staff-secondary" href="/staff/sign-in">Back to sign-in</a>
      </section>
    <% } else if (strMode === 'recovery') { %>
      <section class="staff-card"><h2>Replace your authenticator</h2><p>For owners and administrators with their password and an unused recovery code. Starting recovery signs out existing sessions and revokes the old authenticator. Access stays locked until you confirm its replacement, even if you leave this page.</p>
        <form method="post" action="/auth/unavailable" data-endpoint="/recovery/start" data-result="recovery">
          <%- include('../partials/staff/field', {strId:'strUsername',strLabel:'Username',strType:'text',strAutocomplete:'username',intMax:64,strHint:null}) %>
          <%- include('../partials/staff/field', {strId:'strPassword',strLabel:'Password',strType:'password',strAutocomplete:'current-password',intMax:1024,strHint:null}) %>
          <%- include('../partials/staff/field', {strId:'strRecoveryCode',strLabel:'Unused recovery code',strType:'password',strAutocomplete:'off',intMax:32,strHint:null}) %>
          <button class="btn btn-primary" type="submit" disabled>Begin authenticator replacement</button>
        </form>
        <details class="mt-3"><summary>First administrator authenticator setup</summary><p>For a new admin invitation or an owner-approved promotion. Your password is required. This cannot replace an existing authenticator.</p>
          <form method="post" action="/auth/unavailable" data-endpoint="/promotion/start" data-result="recovery">
            <label class="form-label" for="promotion-username">Setup username</label><input class="form-control" id="promotion-username" name="strUsername" autocomplete="username" maxlength="64" required>
            <label class="form-label" for="promotion-password">Setup password</label><input class="form-control" id="promotion-password" name="strPassword" type="password" autocomplete="current-password" maxlength="1024" required>
            <button class="btn btn-primary mt-2" type="submit" disabled>Begin first authenticator setup</button>
          </form>
        </details>
        <div id="recovery-enrollment" hidden>
          <div id="authenticator-visuals"><p id="authenticator-instructions">In your authenticator app, choose Add account and scan this QR code. Alternatively, enter the private setup key as a time-based account (SHA-1, six digits, 30 seconds). Both contain the same secret: keep them off shared screens and out of chat.</p>
            <canvas id="authenticator-qr" class="authenticator-qr" role="img" aria-label="Private authenticator setup QR code" aria-describedby="authenticator-instructions" hidden></canvas>
            <label for="setup-key">Private setup key</label><textarea id="setup-key" class="form-control" readonly rows="3" spellcheck="false"></textarea>
            <button class="btn btn-outline-primary mt-3" type="button" data-clear="authenticator-visuals">Hide setup key and QR code</button>
          </div>
          <form method="post" action="/auth/unavailable" data-endpoint="/recovery/confirm" data-result="recovered">
            <%- include('../partials/staff/field', {strId:'strCode',strLabel:'New authenticator code',strType:'text',strAutocomplete:'one-time-code',intMax:6,strHint:'Confirm within 10 minutes. You have up to five attempts.'}) %>
            <button class="btn btn-primary" type="submit" disabled>Confirm replacement</button>
          </form>
        </div><a class="staff-secondary" href="/staff/sign-in">Back to sign-in</a>
      </section>
      <aside class="staff-card staff-aside"><h2>Missing a recovery code?</h2><p>Ask Brody to verify your identity in person and oversee the private local recovery procedure. An employee account cannot override admin MFA.</p></aside>
    <% } else { %>
      <section class="staff-card"><h2>Account security</h2><p>Your role: <%= bOwner ? 'Owner' : bAdmin ? 'Admin' : 'Employee' %>. Sessions end after 30 minutes idle or eight hours total.</p>
        <form method="post" action="/auth/unavailable" data-endpoint="/account/password" data-result="password">
          <%- include('../partials/staff/field', {strId:'strCurrentPassword',strLabel:'Current password',strType:'password',strAutocomplete:'current-password',intMax:1024,strHint:null}) %>
          <%- include('../partials/staff/field', {strId:'strNewPassword',strLabel:'New password',strType:'password',strAutocomplete:'new-password',intMax:1024,strHint:'Use at least 15 characters and a unique passphrase. Changing it signs out all your sessions.'}) %>
          <% if (bAdmin) { %><%- include('../partials/staff/field', {strId:'strCode',strLabel:'Fresh authenticator code',strType:'text',strAutocomplete:'one-time-code',intMax:6,strHint:'Wait for a new code if you just used the current one.'}) %><% } else { %><input name="strCode" type="hidden" value=""><% } %>
          <button class="btn btn-primary" type="submit" disabled>Change password and sign out</button>
        </form>
        <form method="post" action="/auth/unavailable" data-endpoint="/logout" data-result="logout" class="mt-4"><button class="btn btn-outline-primary" type="submit" disabled>Sign out</button></form>
      </section>
      <% if (bAdmin) { %>
      <section class="staff-card"><h2>Recovery codes</h2><p>Create ten replacement codes. This invalidates every previous unused code. Save the new set privately; it is shown once.</p>
        <form method="post" action="/auth/unavailable" data-endpoint="/recovery/codes" data-result="codes">
          <%- include('../partials/staff/field', {strId:'strPassword',strLabel:'Verify your password',strType:'password',strAutocomplete:'current-password',intMax:1024,strHint:null}) %>
          <%- include('../partials/staff/field', {strId:'strRecoveryMfa',strLabel:'Fresh code for recovery codes',strType:'text',strAutocomplete:'one-time-code',intMax:6,strHint:null}) %>
          <button class="btn btn-primary" type="submit" disabled>Replace recovery codes</button>
        </form>
      </section>
      <section class="staff-card"><h2><%= bOwner ? 'Invite a team member' : 'Invite an employee' %></h2><p>Share the returned token privately. Admin access requires authenticator enrollment before sign-in.</p>
        <form method="post" action="/auth/unavailable" data-endpoint="/employees/invitations" data-result="invited">
          <%- include('../partials/staff/field', {strId:'strUsername',strLabel:bOwner?'Staff username':'Employee username',strType:'text',strAutocomplete:'off',intMax:64,strHint:'3–64 lowercase letters, numbers, dots, underscores or hyphens.'}) %>
          <% if (bOwner) { %><fieldset class="staff-role-options"><legend>Account role</legend><label><input type="radio" name="strRole" value="employee" checked> Employee</label><label><input type="radio" name="strRole" value="admin"> Admin</label></fieldset><% } %>
          <button class="btn btn-primary mt-3" type="submit" disabled>Create invitation</button>
        </form>
        <div id="invitation-result" hidden><label for="invitation-token">Private invitation token — shown once</label><textarea id="invitation-token" class="form-control" readonly spellcheck="false" rows="3"></textarea><p>Give this token and the username to the recipient. They can enter it at /staff/enroll.</p><button class="btn btn-outline-primary" type="button" data-clear="invitation-result">Hide token</button></div>
      </section>
      <% for (const strList of ['employees', 'invitations']) { %>
      <section class="staff-card" data-list="<%= strList %>"><h2 tabindex="-1"><%= strList === 'employees' ? (bOwner ? 'Staff accounts' : 'Employees') : 'Invitations' %></h2><p class="list-summary" aria-live="polite">Loading current records…</p><ul class="staff-records"></ul><div class="staff-pagination"><button type="button" class="btn btn-outline-primary" data-page="previous" disabled>Previous <%= bOwner && strList === 'employees' ? 'accounts' : strList %></button><button type="button" class="btn btn-outline-primary" data-page="next" disabled>Next <%= bOwner && strList === 'employees' ? 'accounts' : strList %></button><button type="button" class="btn btn-outline-primary" data-page="refresh" disabled>Refresh <%= bOwner && strList === 'employees' ? 'accounts' : strList %></button></div></section>
      <% } %>
      <% } %>
    <% } %>
    </div>
    <section class="staff-card mt-4" id="recovery-codes" hidden aria-labelledby="codes-heading"><h2 id="codes-heading">Save your recovery codes</h2><p>Each code works once. Store them privately, separately from your password. Leaving or hiding this panel clears the display.</p><label for="codes-text">Private recovery codes</label><textarea id="codes-text" class="form-control" readonly rows="10" spellcheck="false"></textarea><button class="btn btn-outline-primary mt-3" type="button" data-clear="recovery-codes">I saved my codes — hide them</button></section>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
