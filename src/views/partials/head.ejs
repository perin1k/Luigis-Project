<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="<%= strDescription %>">
<meta name="theme-color" content="#f5efdf">
<title><%= strTitle %></title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<% if (typeof bPricingPage === 'undefined' || !bPricingPage) { %><script src="/js/theme.js"></script><% } %>
<% if (typeof bTrackingPage !== 'undefined' && bTrackingPage) { %>
<link rel="stylesheet" href="/css/tracking-bundle.css">
<% } else if (typeof bPricingPage !== 'undefined' && bPricingPage) { %>
<link rel="stylesheet" href="/css/order-bundle.css">
<link rel="modulepreload" href="/js/ordering/order-model.js">
<link rel="modulepreload" href="/js/checkout/payment.js">
<script src="/js/theme.js"></script>
<% } else { %>
<link rel="stylesheet" href="/vendor/bootstrap.min.css">
<% if (typeof bStaffPage !== 'undefined' && bStaffPage) { %>
<link rel="stylesheet" href="/css/staff-bundle.css">
<% } else { %>
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/global.css">
<% } %>

<% } %>
