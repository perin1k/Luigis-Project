<%# Shared skip link, navigation and native theme choices. Keep visible labels and keyboard order consistent across pages. %><a class="skip-link" href="#main-content" tabindex="0">Skip to main content</a>
<header class="site-header">
  <div class="container header-inner navbar">
    <a class="brand" href="/"><img class="brand-mark" src="/images/oven-emblem.svg" width="76" height="70" alt=""><span class="brand-wordmark">Luigi’s <span>PIZZA</span></span><span class="visually-hidden"> — home</span></a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/menu">Our menu</a>
      <a href="/#visit">Hours &amp; service</a>
      <a href="/order">Order online</a>
      <a href="/account">My account</a>
      <a href="/staff/sign-in">Staff sign-in</a>
    </nav>
    <fieldset class="theme-control">
      <legend class="theme-label">Appearance</legend>
      <div class="btn-group">
        <% for (const strTheme of ['system', 'light', 'dark']) { %>
          <input type="radio" class="btn-check" name="appearance" id="appearance-<%= strTheme %>" value="<%= strTheme %>" <%= strTheme === 'system' ? 'checked' : '' %> disabled>
          <label class="btn btn-outline-primary" for="appearance-<%= strTheme %>"><%= strTheme[0].toUpperCase() + strTheme.slice(1) %></label>
        <% } %>
      </div>
    </fieldset>
  </div>
</header>
