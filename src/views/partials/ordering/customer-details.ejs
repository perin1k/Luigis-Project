<section data-step="3" aria-labelledby="details-title" hidden>
  <h2 id="details-title" tabindex="-1">Let’s put a name to it.</h2>
  <p id="contact-intro" class="step-description">Who’s picking up? We’ll use your number if we need to reach you about your order.</p>
  <div class="field"><label for="customer-name" class="form-label">Your name</label><input id="customer-name" class="form-control" name="customerName" autocomplete="name" maxlength="100" required></div>
  <div id="phone-field" class="field"><label for="customer-phone" class="form-label">Phone number</label><input id="customer-phone" class="form-control" name="customerPhone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="phone-hint" required><p id="phone-hint" class="field-hint">Include your area code.</p></div>
</section>
